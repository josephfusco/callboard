{
  "core": null,
  "phpVersion": "8.2",
  "plugins": [
    "."
  ],
  "port": 8890,
  "testsPort": 8891,
  "mappings": {
    "wp-content/uploads/callboard": "./tests/fixtures/callboard",
    "wp-content/mu-plugins/callboard-protect-fixtures.php": "./tests/mu-plugins/callboard-protect-fixtures.php",
    "wp-content/mu-plugins/callboard-example-extension.php": "./tests/mu-plugins/callboard-example-extension.php",
    "wp-content/mu-plugins/callboard-example": "./tests/mu-plugins/callboard-example"
  },
  "config": {
    "WP_DEBUG": true,
    "SCRIPT_DEBUG": true,
    "WP_ENVIRONMENT_TYPE": "local"
  },
  "lifecycleScripts": {
    "afterStart": "npx wp-env run cli wp rewrite structure '/%postname%/' --hard >/dev/null && npx wp-env run tests-cli wp rewrite structure '/%postname%/' --hard >/dev/null"
  }
}
