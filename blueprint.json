{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "landingPage": "/",
  "login": true,
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Callboard Demo",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "callboard.zip"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/manifest.json",
      "data": {
        "resource": "url",
        "url": "demo/manifest.json"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/levels.json",
      "data": {
        "resource": "url",
        "url": "demo/levels.json"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/cover.png",
      "data": {
        "resource": "url",
        "url": "demo/cover.png"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/01 - Sonnets 1–10 [son01].mp3",
      "data": {
        "resource": "url",
        "url": "demo/01%20-%20Sonnets%201%E2%80%9310%20%5Bson01%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/02 - Sonnets 11–20 [son02].mp3",
      "data": {
        "resource": "url",
        "url": "demo/02%20-%20Sonnets%2011%E2%80%9320%20%5Bson02%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/03 - Sonnets 21–30 [son03].mp3",
      "data": {
        "resource": "url",
        "url": "demo/03%20-%20Sonnets%2021%E2%80%9330%20%5Bson03%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/04 - Sonnets 31–40 [son04].mp3",
      "data": {
        "resource": "url",
        "url": "demo/04%20-%20Sonnets%2031%E2%80%9340%20%5Bson04%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/05 - Sonnets 41–50 [son05].mp3",
      "data": {
        "resource": "url",
        "url": "demo/05%20-%20Sonnets%2041%E2%80%9350%20%5Bson05%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/06 - Sonnets 51–60 [son06].mp3",
      "data": {
        "resource": "url",
        "url": "demo/06%20-%20Sonnets%2051%E2%80%9360%20%5Bson06%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/07 - Sonnets 61–70 [son07].mp3",
      "data": {
        "resource": "url",
        "url": "demo/07%20-%20Sonnets%2061%E2%80%9370%20%5Bson07%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/08 - Sonnets 71–80 [son08].mp3",
      "data": {
        "resource": "url",
        "url": "demo/08%20-%20Sonnets%2071%E2%80%9380%20%5Bson08%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/09 - Sonnets 81–90 [son09].mp3",
      "data": {
        "resource": "url",
        "url": "demo/09%20-%20Sonnets%2081%E2%80%9390%20%5Bson09%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/10 - Sonnets 91–100 [son10].mp3",
      "data": {
        "resource": "url",
        "url": "demo/10%20-%20Sonnets%2091%E2%80%93100%20%5Bson10%5D.mp3"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; update_option( 'callboard_settings', array( 'tagline' => 'Rehearsal tracks', 'footer_note' => 'For rehearsal use only.', 'badge' => '★', 'confetti' => '22', 'hearts' => true, 'show_hint' => false, 'offline' => true, 'push' => false, 'notify_new_sets' => false, 'notify_calls' => false ) ); Callboard\\Importer::import_all(); $call = wp_insert_post( array( 'post_type' => 'callboard_call', 'post_status' => 'publish', 'post_title' => 'Act I run', 'post_content' => 'Warm-up at 6:45. Bring scripts and a pencil; we are setting the Act I transitions.' ) ); update_post_meta( $call, '_callboard_when', wp_date( 'Y-m-d', strtotime( '+2 days' ) ) . ' 19:00' ); update_post_meta( $call, '_callboard_where', 'Room 204' ); $ids = get_posts( array( 'post_type' => 'attachment', 'post_mime_type' => 'audio', 'posts_per_page' => 2, 'orderby' => 'menu_order', 'order' => 'ASC', 'fields' => 'ids' ) ); update_post_meta( $call, '_callboard_numbers', $ids ); flush_rewrite_rules(); ?>"
    }
  ]
}
