<?xml version="1.0"?>
<!--
	The WordPress test suite, not a mocked stand-in: Callboard's PHP is mostly a conversation with
	WordPress, and a test that mocks that conversation only proves the mock agrees with itself.
	Run it with `npm run test:php`, which starts the tests container and points this at the real thing.
-->
<phpunit
	bootstrap="tests/php/bootstrap.php"
	backupGlobals="false"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	convertDeprecationsToExceptions="true"
	failOnWarning="true"
	failOnRisky="true"
	>
	<testsuites>
		<testsuite name="callboard">
			<directory suffix=".php">./tests/php</directory>
			<exclude>./tests/php/bootstrap.php</exclude>
		</testsuite>
	</testsuites>
</phpunit>
